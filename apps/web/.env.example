# One network, as before the selector:
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8080
NEXT_PUBLIC_NETWORK_LABEL=eCash Betanet

# Several networks, one API each; the header shows a selector. This replaces the two lines above.
# Ids are mainnet or betanet (the copy states facts about each); label defaults to the network's full name.
# NEXT_PUBLIC_NETWORKS=[{"id":"mainnet","apiBaseUrl":"https://mainnet-api.example"},{"id":"betanet","apiBaseUrl":"https://api.example"}]
# NEXT_PUBLIC_DEFAULT_NETWORK=mainnet
